# Copy to .env and put your own postgres password in.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/events
PORT=3000
# Signs the login cookie. At least 32 random characters; the API refuses to
# start without it. Never commit the real value. One way to make one:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Resend (https://resend.com). Not read by the API yet: real email is out of
# scope for M6 (D57); these are here so you can put your key in `.env` now.
# Never commit the real key. Without a verified domain Resend delivers only to
# the address of your own account.
EMAIL_API_KEY=
MAIL_FROM=onboarding@resend.dev

# How often the email job runs (reminder worker, then sender). Default in code: 1 h.
# 10 s for development and demos; the same value is set in .env.
EMAIL_JOB_INTERVAL_MS=10000
