# Copy to .env and put your own postgres password in.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/events
PORT=3000
# Signs the login cookie. At least 32 random characters; the API refuses to
# start without it. Never commit the real value. One way to make one:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Resend (https://resend.com). Required: the API refuses to start without
# EMAIL_API_KEY and MAIL_FROM (D59). Never commit the real key. Without a
# verified domain Resend delivers only to the address of your own account, and
# MAIL_FROM must be onboarding@resend.dev; emails to other addresses end as
# error_sending after 3 tries.
EMAIL_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Optional. The one web origin allowed to call the API with the login cookie
# (CORS), for example https://<web>.onrender.com: exact, no trailing slash, no
# wildcard. With NODE_ENV=production the cookie becomes SameSite=None; Secure.
# Leave it empty for local development (the Vite dev proxy keeps one origin).
CORS_ORIGIN=

# The web reads VITE_API_URL (the API origin, for example
# https://<api>.onrender.com) at build time, from the build environment of the
# web, not from this file. Leave it unset locally: the calls stay relative and
# go through the Vite dev proxy. Changing it needs a rebuild of the web.

# How often the email job runs (reminder worker, then sender). Default in code: 1 h.
# 10 s for development and demos; the same value is set in .env.
EMAIL_JOB_INTERVAL_MS=10000
