{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/spec-first.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "code-writer",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/verify-then-review.sh" }
        ]
      }
    ]
  }
}
