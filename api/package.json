    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
